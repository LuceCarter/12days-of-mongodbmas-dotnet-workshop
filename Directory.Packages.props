<Project>
  <!--
    Central package management. Every version used anywhere in the repo is pinned
    here, exactly once. This matters: these challenges need to still work in
    February, so nothing floats.
    Versions verified 2026-11-03.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="MongoDB">
    <PackageVersion Include="MongoDB.Driver" Version="3.13.0" />
  </ItemGroup>

  <ItemGroup Label="Markdown rendering (landing page)">
    <!-- Targets net10.0 directly and has no dependencies. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!--
      xUnit v3 runs on the Microsoft Testing Platform. Microsoft.NET.Test.Sdk and
      xunit.runner.visualstudio are VSTest-era packages and are deliberately absent —
      the .NET 10 SDK no longer supports VSTest here. The opt-in lives in global.json.
    -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Label="Hosting and configuration">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Blazor WebAssembly (landing page)">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="AI (Parts 4A and 4B)">
    <!--
      One set, resolved together on 2026-11-25. Microsoft.Extensions.AI and VectorData both published 11.x after the
      plan was written, but Agent Framework 1.28.0 and the Semantic Kernel MongoDB connector were built against the
      10.x line, so the whole part stays on 10.x rather than mixing majors. See DECISIONS.md.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <!-- PREVIEW: there is no stable release of this connector. Used only by the optional bridge step in Part 4A. -->
    <PackageVersion Include="Microsoft.SemanticKernel.Connectors.MongoDB" Version="1.74.0-preview" />
  </ItemGroup>
</Project>
