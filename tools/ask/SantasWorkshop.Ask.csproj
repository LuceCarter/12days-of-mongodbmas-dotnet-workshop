<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SantasWorkshop.Ask</RootNamespace>
    <AssemblyName>ask</AssemblyName>
    <!-- Lets `dotnet user-secrets set` work for this tool: keys are kept outside the repository. -->
    <UserSecretsId>santas-workshop-ask</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\part4a-rag\Starter\Part4A.Starter.csproj" />
    <ProjectReference Include="..\..\src\Shared\SantasWorkshop.Shared.csproj" />
  </ItemGroup>

</Project>
