<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    The landing page is deliberately standalone: no server, no database, no auth.
    It builds to static files and is published to GitHub Pages by
    .github/workflows/pages.yml. Nothing here talks to MongoDB.

    Package versions come from Directory.Packages.props (central package
    management), which is why there are no Version attributes below.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!--
      The page is English-only and formats no dates or numbers by culture, so the
      ICU data is pure download weight. Dropping it saves roughly half a megabyte
      off the first load. If this page ever needs localising, delete this line.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Content\SantasWorkshop.Content.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The site renders the repository's own markdown, so there is only ever one copy of each
    README: the one GitHub shows. Before every build, copy the files the site serves into
    wwwroot/content/, keeping their repo-relative paths (content/part1-inventory/README.md,
    content/docs/setup.md). That folder is generated and git-ignored.

    Which files count is decided here by glob, and in ContentCatalog by route. The tests in
    src/Content.Tests check that every route the catalog serves has a file behind it.
  -->
  <!--
    `dotnet watch` only watches the project's own files by default, so editing a README would
    not refresh the preview — you'd keep seeing the copy made at the last build. Tell it these
    files matter, and it rebuilds (re-running CopySiteContent) whenever one changes.
  -->
  <ItemGroup>
    <Watch Include="..\docs\*.md;..\part*\*.md" />
  </ItemGroup>

  <Target Name="CopySiteContent" BeforeTargets="BeforeBuild;ResolveProjectStaticWebAssets">
    <ItemGroup>
      <_SiteDocs Include="$(MSBuildProjectDirectory)\..\docs\*.md" />
      <_SiteParts Include="$(MSBuildProjectDirectory)\..\part*\*.md" />
    </ItemGroup>

    <Copy SourceFiles="@(_SiteDocs)"
          DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\content\docs"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_SiteParts)"
          DestinationFiles="@(_SiteParts->'$(MSBuildProjectDirectory)\wwwroot\content\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
