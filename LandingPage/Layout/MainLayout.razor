@inherits LayoutComponentBase
@inject ChallengeConfig Config
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="site">
    <Festive Enabled="snowing" />

    @* Not a bare "#main": with <base href> that resolves to the site root, so the link would
       send a keyboard user to the home page instead of past the navigation. *@
    <a class="skip-link" href="@(CurrentPath)#main">Skip to content</a>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="wordmark" href="">🎄 Santa's <span>Workshop</span></a>

            <nav class="site-nav" aria-label="Main">
                <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
                @* Setup comes first: you can't start a challenge without it. *@
                <NavLink href="setup">Setup</NavLink>
                <NavLink href="parts">Challenges</NavLink>
                <NavLink href="resources">Resources &amp; FAQ</NavLink>
                <a href="@Config.Repo" target="_blank" rel="noopener">GitHub ↗</a>
                <button type="button" class="snow-toggle" aria-pressed="@(snowing ? "true" : "false")"
                        title="Turn the snow and sleigh on or off" @onclick="ToggleSnow">
                    ❄ Snow
                </button>
            </nav>
        </div>

        <UpsideDownTree />
    </header>

    <main class="site-main" id="main" tabindex="-1">
        @Body
    </main>

    <footer class="site-footer">
        <div class="wrap">
            <div class="site-footer__text">
                <p>
                    Built with MongoDB and .NET. The code lives on
                    <a href="@Config.Repo" target="_blank" rel="noopener">GitHub</a> —
                    issues and pull requests are welcome.
                </p>
                <p>
                    To our southern hemisphere friends: happy summer Christmas.
                    Yes, the tree up in the corner is upside down — that one's for you. 🐨
                </p>
            </div>
        </div>
    </footer>
</div>

@code {
    // Namespaced: GitHub Pages project sites share one origin (and so one localStorage)
    // with every other Pages site the same account publishes.
    private const string SnowKey = "santas-workshop:snow";

    private bool snowing = true;

    // The current page's own path, without any #fragment or ?query.
    private string CurrentPath => Nav.ToBaseRelativePath(Nav.Uri).Split('#', '?')[0];

    // The choice is remembered, so someone who turns the snow off doesn't have to do
    // it again on every visit. If storage is blocked we simply fall back to "on".
    protected override async Task OnInitializedAsync()
    {

        try
        {
            snowing = await JS.InvokeAsync<string?>("localStorage.getItem", SnowKey) != "off";
        }
        catch (JSException) { }
    }

    private async Task ToggleSnow()
    {
        snowing = !snowing;

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SnowKey, snowing ? "on" : "off");
        }
        catch (JSException) { }
    }
}
